# =============================================================================
# Linkforge — environment variables (production-ready reference)
# Copy to `.env` for local dev or inject via Docker secrets / GitHub Actions
# secrets in production.  NEVER commit a real `.env` to version control.
# =============================================================================

# -- App ----------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Linkforge
PORT=3000

# -- Database (Prisma / Postgres) --------------------------------------------
DATABASE_URL=postgresql://linkforge:linkforge@localhost:5432/linkforge?schema=public

# -- Redis (cache + BullMQ + rate limit) -------------------------------------
REDIS_URL=redis://localhost:6379

# -- Auth.js / NextAuth v5 ---------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-base64
AUTH_TRUST_HOST=true

# OAuth providers (leave blank to disable)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email magic-link / verification (use SMTP relay or Resend/Postmark)
EMAIL_FROM=no-reply@kebruni.me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Telegram login widget (bot token + bot username)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# -- Storage (S3-compatible: Cloudflare R2, AWS, MinIO) ----------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=linkforge-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# -- Payments (Stripe) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -- AI features (OpenAI-compatible) -----------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# -- Analytics / GEO ---------------------------------------------------------
# Optional MaxMind GeoLite2 license key for IP → country lookup
MAXMIND_LICENSE_KEY=

# -- Observability -----------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# -- Security ----------------------------------------------------------------
# Comma-separated trusted origins for CSRF (in addition to APP_URL)
TRUSTED_ORIGINS=
# Rate-limit budget per IP per minute for write endpoints
RATE_LIMIT_WRITES_PER_MIN=60
RATE_LIMIT_PUBLIC_VIEWS_PER_MIN=600

# -- Feature flags -----------------------------------------------------------
FEATURE_AI=true
FEATURE_BILLING=false
FEATURE_CUSTOM_DOMAINS=false

# =============================================================================
# Production-only (set via GitHub Actions secrets / Docker secrets)
# =============================================================================
# DEPLOY_HOST=164.92.240.90
# DEPLOY_PORT=2222
# DEPLOY_USER=nurbek
# DEPLOY_SSH_KEY=...
# LETSENCRYPT_EMAIL=admin@kebruni.me
