{
  "name": "linkforge",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade link-in-bio / mini-landing SaaS — Next.js 15 + Prisma + Postgres + Redis + BullMQ.",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "worker": "tsx worker/index.ts",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:start": "node dist/worker/index.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.7.4",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "3.9.1",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@tanstack/react-query": "5.62.7",
    "argon2": "0.41.1",
    "bullmq": "5.34.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.15.0",
    "ioredis": "5.4.2",
    "lucide-react": "0.469.0",
    "next": "15.1.3",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "0.4.4",
    "otplib": "12.0.1",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.1",
    "recharts": "2.15.0",
    "sharp": "0.33.5",
    "tailwind-merge": "2.5.5",
    "tailwindcss-animate": "1.0.7",
    "ua-parser-js": "1.0.39",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/ua-parser-js": "0.7.39",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
