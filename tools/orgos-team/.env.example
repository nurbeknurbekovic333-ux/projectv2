# Canopy Wave inference endpoint (OpenAI-compatible)
CANOPYWAVE_API_KEY=your_canopywave_api_key_here
CANOPYWAVE_BASE_URL=https://inference.canopywave.io/v1

# Default model used by every agent role.
# Override per-role below if you want different models for different agents.
ORGOS_DEFAULT_MODEL=moonshotai/kimi-k2.6

# Optional per-role model overrides. Leave empty to use ORGOS_DEFAULT_MODEL.
ORGOS_MODEL_PRODUCT=
ORGOS_MODEL_ARCHITECT=
ORGOS_MODEL_BACKEND=
ORGOS_MODEL_FRONTEND=
ORGOS_MODEL_DEVOPS=
ORGOS_MODEL_QA=
ORGOS_MODEL_REVIEWER=
ORGOS_MODEL_SECURITY=

# Concurrency: how many LLM calls in flight at once.
# Bump up if you have lots of rate-limit headroom; lower if you hit 429s.
ORGOS_MAX_CONCURRENCY=4

# Temperature for code generation (lower = more deterministic).
ORGOS_TEMPERATURE=0.2

# Optional: where to write generated projects. Default: ./output
ORGOS_OUTPUT_DIR=output

# Optional: GitHub auto-publish. Leave empty to disable.
GITHUB_TOKEN=
GITHUB_OWNER=
