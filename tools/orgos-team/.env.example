# Canopy Wave inference endpoint (OpenAI-compatible)
#
# The shared key is used by any agent that doesn't have its own
# CANOPYWAVE_API_KEY_<ROLE> override below. You can either:
#   (a) set ONLY this shared key and have all 8 agents share it, OR
#   (b) set per-role keys (and leave this empty if you want every role
#       to require its own key — handy for cost tracking / blast-radius
#       isolation across roles), OR
#   (c) mix: set the shared key + override only the roles that need a
#       different account.
CANOPYWAVE_API_KEY=your_canopywave_api_key_here
CANOPYWAVE_BASE_URL=https://inference.canopywave.io/v1

# Per-role API keys. Each one overrides CANOPYWAVE_API_KEY for that role
# only. Leave empty to use the shared key above.
CANOPYWAVE_API_KEY_PRODUCT=
CANOPYWAVE_API_KEY_ARCHITECT=
CANOPYWAVE_API_KEY_BACKEND=
CANOPYWAVE_API_KEY_FRONTEND=
CANOPYWAVE_API_KEY_DEVOPS=
CANOPYWAVE_API_KEY_QA=
CANOPYWAVE_API_KEY_REVIEWER=
CANOPYWAVE_API_KEY_SECURITY=

# Per-role base URLs (optional). Override only if a role lives on a
# different OpenAI-compatible endpoint (e.g. one role on Canopy Wave,
# another on a self-hosted vLLM). Empty -> CANOPYWAVE_BASE_URL.
CANOPYWAVE_BASE_URL_PRODUCT=
CANOPYWAVE_BASE_URL_ARCHITECT=
CANOPYWAVE_BASE_URL_BACKEND=
CANOPYWAVE_BASE_URL_FRONTEND=
CANOPYWAVE_BASE_URL_DEVOPS=
CANOPYWAVE_BASE_URL_QA=
CANOPYWAVE_BASE_URL_REVIEWER=
CANOPYWAVE_BASE_URL_SECURITY=

# Default model used by every agent role.
# Override per-role below if you want different models for different agents.
ORGOS_DEFAULT_MODEL=moonshotai/kimi-k2.6

# Optional per-role model overrides. Leave empty to use ORGOS_DEFAULT_MODEL.
ORGOS_MODEL_PRODUCT=
ORGOS_MODEL_ARCHITECT=
ORGOS_MODEL_BACKEND=
ORGOS_MODEL_FRONTEND=
ORGOS_MODEL_DEVOPS=
ORGOS_MODEL_QA=
ORGOS_MODEL_REVIEWER=
ORGOS_MODEL_SECURITY=

# Concurrency: how many LLM calls in flight at once.
# Bump up if you have lots of rate-limit headroom; lower if you hit 429s.
ORGOS_MAX_CONCURRENCY=4

# Temperature for code generation (lower = more deterministic).
ORGOS_TEMPERATURE=0.2

# Optional: where to write generated projects. Default: ./output
ORGOS_OUTPUT_DIR=output

# Optional: GitHub auto-publish. Leave empty to disable.
GITHUB_TOKEN=
GITHUB_OWNER=
